    {
      "id": "account-all",
      "principal": "admin",
      "query": "SELECT Id,Name,Compat_Text__c,Compat_Key__c FROM Account",
      "querySuffix": "&columns=true",
      "expectedStatus": 200,
      "expectedBody": {
        "totalSize": 1,
        "done": true,
        "records": [
          {
            "attributes": {
              "type": "Account",
              "url": "/services/data/v65.0/sobjects/Account/$accountId"
            },
            "Id": "$accountId",
            "Name": "$name",
            "Compat_Text__c": null,
            "Compat_Key__c": "owned-key"
          }
        ],
        "columnMetadata": [
          {
            "columnName": "Id"
          },
          {
            "columnName": "Name"
          },
          {
            "columnName": "Compat_Text__c"
          },
          {
            "columnName": "Compat_Key__c"
          }
        ]
      },
      "basis": [
        "candidate-contract",
        "pinned-consumer"
      ]
    },
