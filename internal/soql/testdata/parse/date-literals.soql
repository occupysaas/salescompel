SELECT Id FROM Item__c
WHERE Day__c = YESTERDAY
   OR Day__c = TODAY
   OR Day__c = TOMORROW
   OR Day__c = LAST_WEEK
   OR Day__c = THIS_WEEK
   OR Day__c = NEXT_WEEK
   OR Day__c = LAST_MONTH
   OR Day__c = THIS_MONTH
   OR Day__c = NEXT_MONTH
   OR Day__c = LAST_QUARTER
   OR Day__c = THIS_QUARTER
   OR Day__c = NEXT_QUARTER
   OR Day__c = LAST_YEAR
   OR Day__c = THIS_YEAR
   OR Day__c = NEXT_YEAR
   OR Day__c = LAST_90_DAYS
   OR Day__c = NEXT_90_DAYS
   OR Day__c = LAST_FISCAL_QUARTER
   OR Day__c = THIS_FISCAL_QUARTER
   OR Day__c = NEXT_FISCAL_QUARTER
   OR Day__c = LAST_FISCAL_YEAR
   OR Day__c = THIS_FISCAL_YEAR
   OR Day__c = NEXT_FISCAL_YEAR
   OR Day__c = LAST_N_DAYS:30
   OR Day__c = NEXT_N_DAYS:30
   OR Day__c = N_DAYS_AGO:3
   OR Day__c = LAST_N_WEEKS:2
   OR Day__c = NEXT_N_WEEKS:2
   OR Day__c = N_WEEKS_AGO:1
   OR Day__c = LAST_N_MONTHS:2
   OR Day__c = NEXT_N_MONTHS:2
   OR Day__c = N_MONTHS_AGO:1
   OR Day__c = LAST_N_QUARTERS:2
   OR Day__c = NEXT_N_QUARTERS:2
   OR Day__c = N_QUARTERS_AGO:1
   OR Day__c = LAST_N_YEARS:2
   OR Day__c = NEXT_N_YEARS:2
   OR Day__c = N_YEARS_AGO:1
   OR Day__c = LAST_N_FISCAL_QUARTERS:2
   OR Day__c = NEXT_N_FISCAL_QUARTERS:2
   OR Day__c = N_FISCAL_QUARTERS_AGO:1
   OR Day__c = LAST_N_FISCAL_YEARS:2
   OR Day__c = NEXT_N_FISCAL_YEARS:2
   OR Day__c = N_FISCAL_YEARS_AGO:1
