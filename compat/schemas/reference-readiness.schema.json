{
  "type": "object",
  "required": [
    "schemaVersion",
    "referenceAlias",
    "profile",
    "profileHash",
    "apiVersion",
    "decision",
    "observer",
    "implementer",
    "scenarios",
    "fixtures"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "referenceAlias": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "type": "string",
      "pattern": "\\S"
    },
    "profileHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "apiVersion": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+\\.0$"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "type": "object",
      "required": [
        "status",
        "maintainer",
        "recordedAt",
        "logAnchor",
        "observationAuthorized"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "maintainer": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "logAnchor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observationAuthorized": {
          "type": "boolean"
        }
      }
    },
    "observer": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "implementer": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "scenarios": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "fixtures": {
      "type": "object",
      "required": [
        "disposable",
        "administrator",
        "restricted",
        "locale",
        "deployed"
      ],
      "additionalProperties": false,
      "properties": {
        "disposable": {
          "type": "boolean"
        },
        "administrator": {
          "type": "boolean"
        },
        "restricted": {
          "type": "boolean"
        },
        "locale": {
          "type": "boolean"
        },
        "deployed": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
