{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "description",
    "apiVersion",
    "timezone",
    "currency",
    "referenceStatus",
    "openapi",
    "clouds",
    "objects",
    "fields",
    "personas",
    "requiredScenarios",
    "languages",
    "locales",
    "managedPackages",
    "orgFeatures",
    "connectors"
  ],
  "additionalProperties": false,
  "properties": {
    "orgFeatures": {
      "type": "object",
      "required": [
        "personAccounts",
        "multiCurrency",
        "legacyAutomation",
        "externalServicesOpenApi2"
      ],
      "additionalProperties": false,
      "properties": {
        "personAccounts": {
          "type": "boolean"
        },
        "multiCurrency": {
          "type": "boolean"
        },
        "legacyAutomation": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "WorkflowRule",
              "ProcessBuilder",
              "AssignmentRule",
              "AutoResponseRule",
              "EscalationRule"
            ]
          }
        },
        "externalServicesOpenApi2": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "apiVersion": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+\\.0$"
        }
      ]
    },
    "timezone": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "referenceStatus": {
      "enum": [
        "pending",
        "observed"
      ]
    },
    "openapi": {
      "const": "3.0-only"
    },
    "clouds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "personas": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredScenarios": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "locales": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "managedPackages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "connectors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    }
  }
}
