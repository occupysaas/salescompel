{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "description",
    "apiVersion",
    "timezone",
    "currency",
    "referenceStatus",
    "openapi",
    "clouds",
    "objects",
    "fields",
    "personas",
    "requiredScenarios",
    "languages",
    "locales",
    "managedPackages",
    "orgFeatures",
    "connectors",
    "salesforceCli",
    "cliPlugins"
  ],
  "additionalProperties": false,
  "properties": {
    "orgFeatures": {
      "type": "object",
      "required": [
        "personAccounts",
        "multiCurrency",
        "legacyAutomation",
        "externalServicesOpenApi2"
      ],
      "additionalProperties": false,
      "properties": {
        "personAccounts": {
          "type": "boolean"
        },
        "multiCurrency": {
          "type": "boolean"
        },
        "legacyAutomation": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "WorkflowRule",
              "ProcessBuilder",
              "AssignmentRule",
              "AutoResponseRule",
              "EscalationRule"
            ]
          }
        },
        "externalServicesOpenApi2": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "apiVersion": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9]+\\.0$"
        }
      ]
    },
    "timezone": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "referenceStatus": {
      "enum": [
        "pending",
        "observed"
      ]
    },
    "openapi": {
      "const": "3.2"
    },
    "clouds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "personas": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredScenarios": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "locales": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "managedPackages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "connectors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    },
    "salesforceCli": {
      "type": "object",
      "required": [
        "channels",
        "endpoint",
        "proxiedHosts",
        "commands"
      ],
      "additionalProperties": false,
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "npm",
              "installer",
              "tarball",
              "docker-slim",
              "docker-full"
            ]
          }
        },
        "endpoint": {
          "enum": [
            "native",
            "proxy"
          ]
        },
        "proxiedHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.*-]+$"
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*( [a-z][a-z-]*)*$"
          }
        }
      }
    },
    "cliPlugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "source",
          "signature",
          "license",
          "commands"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "source": {
            "enum": [
              "core",
              "jit",
              "npm",
              "github",
              "tarball"
            ]
          },
          "signature": {
            "enum": [
              "bundled",
              "verified",
              "unsigned-allowlisted"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z-]*( [a-z][a-z-]*)*$"
            }
          }
        }
      }
    }
  }
}
