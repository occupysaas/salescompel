{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "metadata-discovery"
    },
    "scope": {
      "$ref": "#/$defs/config"
    },
    "profileHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "connectors": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 30,
      "additionalProperties": {
        "type": "string",
        "maxLength": 100
      }
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "finishedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "identityVerified": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial": {
          "type": "boolean"
        },
        "final": {
          "type": "boolean"
        }
      },
      "required": [
        "initial",
        "final"
      ]
    },
    "operations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "kind": {
            "enum": [
              "describe",
              "metadata",
              "retrieve"
            ]
          },
          "persona": {
            "enum": [
              "administrator",
              "restricted"
            ]
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "state": {
            "enum": [
              "observed",
              "unavailable",
              "blocked"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "persona",
          "component",
          "state"
        ]
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "area": {
            "enum": [
              "describe",
              "metadata",
              "retrieve"
            ]
          },
          "persona": {
            "enum": [
              "administrator",
              "restricted"
            ]
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "property": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "value": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1024
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 1024
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "sourceRef",
          "area",
          "persona",
          "component",
          "property",
          "value"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "area": {
            "enum": [
              "describe",
              "metadata",
              "retrieve"
            ]
          },
          "persona": {
            "enum": [
              "administrator",
              "restricted"
            ]
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "property": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "state": {
            "enum": [
              "unavailable",
              "unsupported",
              "unrequested",
              "conflict"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          },
          "owner": {
            "const": "platform-implementer"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "sourceRef",
          "area",
          "persona",
          "component",
          "property",
          "state",
          "code",
          "owner",
          "required"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8388608
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256",
          "component"
        ]
      }
    },
    "outcome": {
      "enum": [
        "complete",
        "incomplete",
        "blocked"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "scope",
    "profileHash",
    "connectors",
    "startedAt",
    "finishedAt",
    "identityVerified",
    "operations",
    "facts",
    "gaps",
    "artifacts",
    "outcome"
  ],
  "$defs": {
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "apiVersion": {
          "const": "65.0"
        },
        "profile": {
          "const": "rest-query-foundation"
        },
        "profileHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "profiles": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\x00-\\x1f\\x7f*?]+$"
          }
        },
        "permissionSets": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\x00-\\x1f\\x7f*?]+$"
          }
        }
      },
      "required": [
        "schemaVersion",
        "apiVersion",
        "profile",
        "profileHash",
        "origin"
      ]
    }
  }
}
