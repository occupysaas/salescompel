{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "languages"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "bcp47",
          "category",
          "direction",
          "fallback",
          "coverage"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$"
          },
          "bcp47": {
            "type": "string",
            "minLength": 2
          },
          "category": {
            "enum": [
              "fully",
              "end-user",
              "platform-only"
            ]
          },
          "direction": {
            "enum": [
              "ltr",
              "rtl"
            ]
          },
          "fallback": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage": {
            "enum": [
              "fixture",
              "partial",
              "complete"
            ]
          }
        }
      }
    }
  }
}
